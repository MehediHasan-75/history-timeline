{
  "name": "history-timeline",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual Gregorian and Bengali history timeline",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./assets/css/input.css -o ./static/dist/app.v1.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./assets/css/input.css -o ./static/dist/app.v1.css --watch",
    "build:js": "esbuild ./assets/js/app.js --bundle --minify --sourcemap --loader:.less=empty --outfile=./static/dist/app.v1.js",
    "watch:js": "esbuild ./assets/js/app.js --bundle --sourcemap --loader:.less=empty --outfile=./static/dist/app.v1.js --watch",
    "build:vendor": "node ./scripts/copy-timeline-assets.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:vendor",
    "test": "node --test tests/ui-contract.test.mjs"
  },
  "dependencies": {
    "@knight-lab/timelinejs": "3.9.13"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "tailwindcss": "3.4.17"
  }
}
